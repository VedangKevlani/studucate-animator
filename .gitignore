*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

syn_out/
checkpoints/
.gradio

# Ignore generated sample .wav files
**/*.wav

# Chatterbox web UI - generated clips, not source
outputs/

# Rhubarb Lip Sync binaries, downloaded by install_rhubarb.py
/tools/

